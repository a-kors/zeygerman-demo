---
import { Image } from 'astro:assets';
import manifestoImg from '../assets/photos/manifesto.jpg';
---

<section class="man" aria-labelledby="manifesto-h" data-lit-scene>
  <div class="stick">
  <div class="wrap grid">
    <figure class="photo" data-reveal>
      <Image
        src={manifestoImg}
        alt="Полина Зейгерман"
        widths={[520, 780, 1040]}
        sizes="(max-width: 860px) 480px, 520px"
        format="webp"
        quality={88}
        loading="lazy"
        class="photo-img"
      />
    </figure>

    <div class="copy" data-lit-copy>
      <span class="eyebrow">Во что я верю</span>

      <h2 id="manifesto-h" data-lit>
        Человек способен
        <br />восстановить <em>доверие
        <br />к&nbsp;миру.</em>
      </h2>

      <p class="lead" data-lit>
        Даже если оно было утрачено из&#8209;за травм, потерь или
        предательства. С&nbsp;помощью контакта с&nbsp;природой, творчества,
        заботы о&nbsp;теле и&nbsp;понимания своих чувств и&nbsp;эмоций.
      </p>

      <p class="meta" data-reveal>
        <span class="tag">телесная терапия</span>
        <span class="tag">арт-терапия</span>
        <span class="tag">процессуальная терапия</span>
      </p>
    </div>
  </div>
  </div>
</section>

<style>
  .man {
    padding: clamp(80px, 11vw, 160px) 0;
    background: #ffffff;
    overflow-x: clip; /* clip, а не hidden: не ломает sticky */
  }
  /* широкий экран: блок прилипает, текст «загорается» прокруткой */
  @media (min-width: 861px) {
    .man {
      --sticky: 1;
      height: 230vh;
      padding: 0;
    }
    .stick {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      align-items: center;
      padding-top: 62px; /* под шапкой */
    }
    .photo-img {
      height: min(74vh, 693px);
      width: auto;
      transform: scale(calc(1.07 - 0.07 * var(--mp, 1)));
      transform-origin: 50% 60%;
    }
    .photo {
      overflow: hidden;
      border-radius: 2px;
      justify-self: center;
    }
    .eyebrow {
      margin-bottom: 28px;
    }
  }
  /* слово: из бледного в полный цвет */
  :global(html.motion) [data-lit] :global(.lw) {
    opacity: calc(0.14 + 0.86 * var(--lp, 0));
  }
  .grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .grid > * {
    min-width: 0;
  }

  /* фото: полноразмерный портрет */
  .photo {
    margin: 0;
    position: relative;
  }
  .photo-img {
    width: 100%;
    max-width: 520px;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
    border-radius: 2px;
  }
  /* правая колонка */
  .eyebrow {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 36px;
    font-weight: 500;
  }
  h2 {
    font-family: var(--font-serif);
    font-size: clamp(34px, 3.8vw, 58px);
    line-height: 1.04;
    letter-spacing: -0.025em;
    font-weight: 400;
    color: var(--ink);
    margin-bottom: 40px;
  }
  h2 em {
    font-style: italic;
    color: var(--accent);
  }
  .lead {
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 480px;
    margin-bottom: 36px;
  }
  .meta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .tag {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    padding: 7px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .photo {
      max-width: 480px;
      width: 100%;
      margin: 0 auto;
    }
  }
</style>
