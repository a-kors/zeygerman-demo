---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { master, cards, practices } from '../data/master';

const imgs = import.meta.glob<{ default: ImageMetadata }>('/src/assets/cards/*.jpg', { eager: true });
const imgFor = (key: string) =>
  Object.entries(imgs).find(([p]) => p.includes(key))?.[1].default;
---

<section id="cards" class="cd">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <span class="section-eyebrow">Авторские метафорические карты</span>
      <h2>Две авторские колоды: для&nbsp;работы <em>с&nbsp;собой</em> и&nbsp;в&nbsp;консультировании.</h2>
      <p>
        Образы на&nbsp;картах помогают обратиться к&nbsp;бессознательному,
        увидеть желания из&nbsp;глубины и&nbsp;найти ответы на&nbsp;вопросы.
        Подходят для&nbsp;работы с&nbsp;психологом и&nbsp;для&nbsp;самостоятельной практики.
      </p>
    </header>

    <div class="decks">
      {cards.map((c, i) => {
        const img = imgFor(c.key);
        return (
          <article class="deck" data-reveal data-reveal-delay={i * 120}>
            {img && (
              <Image
                src={img}
                alt={`Метафорические карты ${c.title}`}
                widths={[540, 810, 1080]}
                sizes="(max-width: 900px) 92vw, 560px"
                format="webp"
                quality={86}
                loading="lazy"
                class="deck-img"
              />
            )}
            <div class="deck-body">
              <h3>{c.title}</h3>
              <p class="deck-sub">{c.sub}</p>
              <p class="deck-text">{c.text}</p>
              <ul class="deck-facts">
                {c.facts.map((f) => <li>{f}</li>)}
              </ul>
              <div class="deck-foot">
                <span class="deck-price">{c.price}</span>
                <a class="btn btn-secondary" href={master.vkMarket} target="_blank" rel="noopener">
                  <span>Заказать</span>
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <div class="practices" data-reveal>
      <div class="pr-head">
        <span class="section-eyebrow">Попробовать самостоятельно</span>
        <h3>Практики в&nbsp;сообществе: подготовка не&nbsp;нужна.</h3>
        <a class="pr-link" href={master.vkPractices} target="_blank" rel="noopener">Открыть практики →</a>
      </div>
      <ol class="pr-list">
        {practices.map((p) => (
          <li>
            <span class="pr-title">{p.title}</span>
            {p.time && <span class="pr-time">{p.time}</span>}
            <span class="pr-text">{p.text}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .cd {
    background: var(--bg-soft);
  }
  .section-head {
    max-width: 760px;
  }
  .section-head h2 em {
    font-style: italic;
    color: var(--accent);
  }
  .decks {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-bottom: 72px;
  }
  .deck {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .deck-img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .deck-body {
    padding: 26px 28px 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-grow: 1;
  }
  .deck h3 {
    font-family: var(--font-serif);
    font-size: 24px;
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: -0.015em;
    margin: 0;
    color: var(--ink);
  }
  .deck-sub {
    margin: 0;
    font-size: 14px;
    color: var(--accent);
  }
  .deck-text {
    margin: 4px 0 0;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-muted);
  }
  .deck-facts {
    list-style: none;
    padding: 0;
    margin: 6px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .deck-facts li {
    font-size: 12.5px;
    padding: 6px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink);
    white-space: nowrap;
  }
  .deck-foot {
    margin-top: auto;
    padding-top: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .deck-price {
    font-family: var(--font-serif);
    font-size: 28px;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .practices {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(28px, 5vw, 64px);
    padding: clamp(28px, 4vw, 48px);
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .pr-head h3 {
    font-family: var(--font-serif);
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.2;
    font-weight: 400;
    letter-spacing: -0.015em;
    margin: 12px 0 18px;
    color: var(--ink);
  }
  .pr-link,
  .pr-link:link,
  .pr-link:visited {
    color: var(--accent);
    text-decoration: none;
    font-size: 15px;
  }
  .pr-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  .pr-list li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 16px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }
  .pr-list li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .pr-title {
    font-weight: 500;
    color: var(--ink);
  }
  .pr-time {
    font-size: 13px;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .pr-text {
    grid-column: 1 / -1;
    font-size: 14.5px;
    color: var(--ink-muted);
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .decks,
    .practices {
      grid-template-columns: 1fr;
    }
  }
</style>
